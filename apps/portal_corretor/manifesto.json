{
  "nome": "Portal do Corretor",
  "versao": "0.1.6",
  "descricao": "CRM, funil com IA, WhatsApp, conteúdo para Instagram, página própria e portal do cliente para corretores de imóveis",
  "identidade": "rafaleandrog/app-corretor::portal_corretor",
  "shell_min": "0.56.37",
  "sdk_min": 100,
  "aceita_externos": true,
  "ia": {
    "slots": {
      "conteudo": {
        "titulo": "Conteúdo",
        "base": "normal",
        "descricao": "Descrições de imóveis, legendas e textos do Estúdio"
      },
      "fotos": {
        "titulo": "Leitura de fotos",
        "base": "arquivos",
        "descricao": "Lê as fotos do imóvel para sugerir capa, ordem e legenda"
      },
      "assistente": {
        "titulo": "Assistente do Corretor",
        "base": "normal",
        "descricao": "Responde dúvidas pela ajuda do app, ajuda a decidir e propõe lembretes e agendamentos (o corretor confirma)"
      }
    }
  },
  "roles": {
    "escrita": {
      "operacao": "Equipe da plataforma: convida corretores e acompanha os convites"
    }
  },
  "roles_externos": {
    "escrita": {
      "corretor": "Corretor: usa o app inteiro na própria conta"
    }
  },
  "provisiona_externos": {
    "papel": "operacao"
  },
  "nav": [
    {
      "titulo": "Início",
      "rota": "/",
      "icone": "fa-solid fa-house"
    },
    {
      "titulo": "Clientes",
      "rota": "/clientes",
      "icone": "fa-solid fa-address-book"
    },
    {
      "titulo": "Imóveis",
      "rota": "/imoveis",
      "icone": "fa-solid fa-building"
    },
    {
      "titulo": "Estúdio",
      "rota": "/estudio",
      "icone": "fa-solid fa-wand-magic-sparkles"
    },
    {
      "titulo": "Minha página",
      "rota": "/pagina",
      "icone": "fa-solid fa-globe"
    },
    {
      "titulo": "Desempenho",
      "rota": "/desempenho",
      "icone": "fa-solid fa-chart-line"
    },
    {
      "titulo": "Assistente",
      "rota": "/assistente",
      "icone": "fa-solid fa-comments"
    },
    {
      "titulo": "Ajustes",
      "rota": "/ajustes",
      "icone": "fa-solid fa-sliders"
    },
    {
      "titulo": "Equipe da plataforma",
      "icone": "fa-solid fa-users-gear",
      "itens": [
        {
          "titulo": "Corretores",
          "rota": "/corretores"
        }
      ]
    }
  ],
  "rotinas": {
    "reclassificar_contatos": {
      "titulo": "Temperatura dos contatos",
      "descricao": "Recalcula a temperatura de quem ficou sem contato (esfria depois de 7 dias)",
      "frequencia": "diaria"
    },
    "renovar_tokens_instagram": {
      "titulo": "Conexões do Instagram",
      "descricao": "Renova o acesso ao Instagram das contas antes de vencer (60 dias)",
      "frequencia": "diaria"
    }
  },
  "rotas_publicas": [
    "/vitrine"
  ],
  "paginas_publicas": {
    "/p": {
      "titulo": "Corretor de imóveis",
      "componente": "pc-pagina-publica"
    },
    "/l": {
      "titulo": "Abrindo o imóvel",
      "componente": "pc-link-rastreado"
    },
    "/s": {
      "titulo": "Imóveis para você",
      "componente": "pc-selecao-publica"
    },
    "/c": {
      "titulo": "Portal do cliente",
      "componente": "pc-portal-cliente"
    }
  },
  "webhooks": {
    "formulario_lead": {
      "modo": "recorrente",
      "descricao": "Formulário de contato da página do corretor e da ficha pública do imóvel (um endereço por conta)",
      "campos": {
        "nome": {
          "tipo": "string",
          "obrigatorio": true,
          "descartar": true,
          "exemplo": "Maria Souza"
        },
        "telefone": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": "+5561999990000"
        },
        "email": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": "maria@exemplo.com"
        },
        "mensagem": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": "Gostaria de visitar este imóvel."
        },
        "imovel_codigo": {
          "tipo": "string",
          "obrigatorio": false,
          "exemplo": "IM-0001"
        },
        "consentimento": {
          "tipo": "boolean",
          "obrigatorio": true,
          "exemplo": true
        },
        "site": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": ""
        }
      }
    },
    "clique_link": {
      "modo": "recorrente",
      "descricao": "Clique no link de imóvel que o corretor enviou ao cliente (um endereço por conta)",
      "campos": {
        "codigo": {
          "tipo": "string",
          "obrigatorio": true,
          "exemplo": "aB3dE9xYz1"
        }
      }
    },
    "reacao_selecao": {
      "modo": "recorrente",
      "descricao": "Reação do cliente aos imóveis de uma seleção enviada pelo corretor (um endereço por seleção, com validade)",
      "campos": {
        "imovel_codigo": {
          "tipo": "string",
          "obrigatorio": true,
          "exemplo": "IM-0001"
        },
        "reacao": {
          "tipo": "string",
          "obrigatorio": true,
          "exemplo": "gostei"
        },
        "comentario": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": "Gostei da varanda"
        }
      }
    },
    "acao_cliente": {
      "modo": "recorrente",
      "descricao": "Mensagem ou pedido de remarcar visita enviado pelo cliente no portal (um endereço por cliente)",
      "campos": {
        "tipo": {
          "tipo": "string",
          "obrigatorio": true,
          "exemplo": "mensagem"
        },
        "texto": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": "Posso visitar no sábado?"
        },
        "visita": {
          "tipo": "number",
          "obrigatorio": false,
          "exemplo": 42
        }
      }
    }
  },
  "eventos": {
    "lead_recebido": {
      "descricao": "Alguém pediu contato pela página do corretor ou pela ficha pública de um imóvel.",
      "campos": [
        "nome",
        "telefone",
        "email",
        "mensagem",
        "imovel_codigo",
        "origem",
        "responsavel_id"
      ],
      "conteudo": "Novo contato pela sua página",
      "api": "pagina",
      "rota": "clientes",
      "segregado_por_conta": true
    },
    "link_clicado": {
      "descricao": "O cliente abriu o link de imóvel que o corretor enviou.",
      "campos": [
        "codigo"
      ],
      "conteudo": "Um cliente abriu o imóvel que você enviou",
      "api": "pagina",
      "rota": "clientes",
      "segregado_por_conta": true
    },
    "reacao_recebida": {
      "descricao": "O cliente reagiu a um imóvel de uma seleção (gostou, não gostou ou quer visitar).",
      "campos": [
        "selecao_id",
        "imovel_codigo",
        "reacao",
        "comentario"
      ],
      "conteudo": "Um cliente reagiu à seleção que você enviou",
      "api": "selecoes",
      "rota": "clientes",
      "segregado_por_conta": true
    },
    "acao_cliente_recebida": {
      "descricao": "O cliente mandou uma mensagem ou pediu para remarcar uma visita pelo portal.",
      "campos": [
        "contato_id",
        "tipo",
        "texto",
        "visita"
      ],
      "conteudo": "Um cliente escreveu pelo portal",
      "api": "selecoes",
      "rota": "clientes",
      "segregado_por_conta": true
    },
    "publicacao_programada": {
      "descricao": "Chegou a hora de publicar uma peça agendada no Instagram.",
      "campos": [
        "peca_id",
        "agendada_para"
      ],
      "conteudo": "Publicação agendada do Estúdio",
      "api": "estudio/pecas/{peca_id}",
      "rota": "estudio",
      "segregado_por_conta": true
    },
    "lembrete_visita": {
      "descricao": "Chegou a hora de lembrar o corretor de uma visita marcada.",
      "campos": [
        "atividade_id",
        "quando"
      ],
      "conteudo": "Hora do lembrete de uma visita",
      "api": "atividades",
      "rota": "?aba=agenda",
      "segregado_por_conta": true
    }
  },
  "parametros": {
    "meta_app_id": {
      "tipo": "string",
      "nullable": true,
      "padrao": null,
      "descricao": "ID do app registrado na Meta (Instagram API com login do Instagram)"
    },
    "meta_app_secret": {
      "tipo": "string",
      "secret": true,
      "nullable": true,
      "descricao": "Chave secreta do app da Meta (troca e renovação de tokens do Instagram)"
    }
  }
}
