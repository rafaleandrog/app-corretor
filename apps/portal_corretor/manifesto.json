  "webhooks": {
    "formulario_lead": {
      "modo": "recorrente",
      "descricao": "Formulário de contato da página do corretor e da ficha pública do imóvel (um endereço por conta)",
      "campos": {
        "nome": {
          "tipo": "string",
          "obrigatorio": true,
          "descartar": true,
          "exemplo": "Maria Souza"
        },
        "telefone": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": "+5561999990000"
        },
        "email": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": "maria@exemplo.com"
        },
        "mensagem": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": "Gostaria de visitar este imóvel."
        },
        "imovel_codigo": {
          "tipo": "string",
          "obrigatorio": false,
          "exemplo": "IM-0001"
        },
        "consentimento": {
          "tipo": "boolean",
          "obrigatorio": true,
          "exemplo": true
        },
        "site": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": ""
        }
      }
    },
    "clique_link": {
      "modo": "recorrente",
      "descricao": "Clique no link de imóvel que o corretor enviou ao cliente (um endereço por conta)",
      "campos": {
        "codigo": {
          "tipo": "string",
          "obrigatorio": true,
          "exemplo": "aB3dE9xYz1"
        }
      }
    },
    "reacao_selecao": {
      "modo": "recorrente",
      "descricao": "Reação do cliente aos imóveis de uma seleção enviada pelo corretor (um endereço por seleção, com validade)",
      "campos": {
        "imovel_codigo": {
          "tipo": "string",
          "obrigatorio": true,
          "exemplo": "IM-0001"
        },
        "reacao": {
          "tipo": "string",
          "obrigatorio": true,
          "exemplo": "gostei"
        },
        "comentario": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": "Gostei da varanda"
        }
      }
    },
    "acao_cliente": {
      "modo": "recorrente",
      "descricao": "Mensagem, pedido de remarcar visita, pendência marcada como feita, oferta nova ou aceite de condição pelo cliente no portal (um endereço por cliente)",
      "campos": {
        "tipo": {
          "tipo": "string",
          "obrigatorio": true,
          "exemplo": "mensagem"
        },
        "texto": {
          "tipo": "string",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": "Posso visitar no sábado?"
        },
        "visita": {
          "tipo": "number",
          "obrigatorio": false,
          "exemplo": 42
        },
        "tarefa": {
          "tipo": "number",
          "obrigatorio": false,
          "exemplo": 7
        },
        "negociacao": {
          "tipo": "number",
          "obrigatorio": false,
          "exemplo": 12
        },
        "proposta": {
          "tipo": "number",
          "obrigatorio": false,
          "exemplo": 30
        },
        "valor_c": {
          "tipo": "number",
          "obrigatorio": false,
          "descartar": true,
          "exemplo": 138000000
        }
      }
    }
  },
