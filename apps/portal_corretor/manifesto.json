{
  "nome": "Portal do Corretor",
  "versao": "0.1.26",
  "descricao": "CRM, funil com IA, WhatsApp, conteúdo para Instagram, página própria e portal do cliente para corretores de imóveis",
  "identidade": "rafaleandrog/app-corretor::portal_corretor",
  "shell_min": "0.56.37",
  "sdk_min": 100,
  "aceita_externos": true,
  "ia": {
    "slots": {
      "conteudo": {
        "titulo": "Conteúdo",
        "base": "normal",
        "descricao": "Descrições de imóveis, legendas e textos do Estúdio"
      },
      "fotos": {
        "titulo": "Leitura de fotos",
        "base": "arquivos",
        "descricao": "Lê as fotos do imóvel para sugerir capa, ordem e legenda"
      },
      "assistente": {
        "titulo": "Assistente do Corretor",
        "base": "normal",
        "descricao": "Responde dúvidas pela ajuda do app, ajuda a decidir e propõe lembretes e agendamentos (o corretor confirma)"
      },
      "funil": {
        "titulo": "Mensagem sugerida",
        "base": "barato",
        "descricao": "Adapta a abordagem do playbook ao histórico do contato, na ficha (o corretor revisa e envia)"
      },
      "negociador": {
        "titulo": "Negociador",
        "base": "poder",
        "descricao": "Lê a objeção, estima o teto do comprador e propõe o próximo movimento dentro do mandato (o app valida antes de mostrar ou enviar)"
      }
    }
  },
  "roles": {
