{
  "name": "portal_corretor",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild frontend/index.ts --bundle --external:@urbiverso/ui --format=esm --outfile=frontend/index.js --target=es2022 --minify --tsconfig=tsconfig.json && esbuild backend/rotas.ts --bundle --minify --format=esm --outfile=backend/rotas.js --platform=node --target=node20 --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "ajuda": "node scripts/gerar-ajuda.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "rm -rf .teste && esbuild testes/*.test.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=.teste --out-extension:.js=.mjs --log-level=warning && node --test .teste/*.test.mjs",
    "empacotar": "pnpm build && urbi-empacotar portal_corretor --dir . --saida ../../dist"
  },
  "dependencies": {
    "express": "catalog:",
    "lit": "catalog:"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@urbiverso/sdk": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  }
}
